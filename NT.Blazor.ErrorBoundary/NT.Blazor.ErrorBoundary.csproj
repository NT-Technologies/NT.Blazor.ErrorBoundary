<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Build-time Sass only: without this, Debug builds embed a [SassCompiler] attribute referencing an assembly consumers and WebAssembly never receive. -->
    <SassCompilerEnableWatcher>false</SassCompilerEnableWatcher>
    <ClientAssetsRoot>$(MSBuildProjectDirectory)\..</ClientAssetsRoot>
    <ClientAssetSource>$(MSBuildProjectDirectory)\wwwroot\nt-blazor-error-boundary.ts</ClientAssetSource>
    <ClientAssetOutput>$(MSBuildProjectDirectory)\wwwroot\nt-blazor-error-boundary.js</ClientAssetOutput>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>NT.Blazor.ErrorBoundary</PackageId>
    <Authors>NT Technologies</Authors>
    <Description>Reusable Blazor error boundary reporting with generic fallback UI and configurable HTTP telemetry.</Description>
    <PackageProjectUrl>https://github.com/NT-Technologies/NT.Blazor.ErrorBoundary</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;error-boundary;logging;telemetry</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NT-Technologies/NT.Blazor.ErrorBoundary.git</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\nt-blazor-error-boundary.js" />
    <Content Remove="wwwroot\nt-blazor-error-boundary.ts" />
    <None Remove="wwwroot\nt-blazor-error-boundary.ts" />
    <Content Include="wwwroot\nt-blazor-error-boundary.js" />
    <None Include="wwwroot\nt-blazor-error-boundary.ts" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Framework packages are pinned per target framework to the lowest version of that major the library supports. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.107.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NT.Blazor.ErrorBoundary.Tests</_Parameter1>
    </AssemblyAttribute>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\Logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>


  <Target Name="RestoreClientAssetDependencies" Inputs="$(ClientAssetsRoot)\package-lock.json" Outputs="$(ClientAssetsRoot)\node_modules\.nt-blazor-error-boundary.restore.stamp;$(ClientAssetsRoot)\node_modules\.bin\tsc">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(ClientAssetsRoot)" />
    <Touch Files="$(ClientAssetsRoot)\node_modules\.nt-blazor-error-boundary.restore.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="CompileClientAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="RestoreClientAssetDependencies" Inputs="$(ClientAssetSource);$(ClientAssetsRoot)\package.json;$(ClientAssetsRoot)\package-lock.json;$(ClientAssetsRoot)\tsconfig.json" Outputs="$(ClientAssetOutput)">
    <Exec Command="npm run build" WorkingDirectory="$(ClientAssetsRoot)" />
  </Target>

  <!-- Each target framework compiles Sass in turn, and only the first reports generated files. Include the output exactly once in every target framework. -->
  <Target Name="IncludeCompiledScopedCss" AfterTargets="Compile Sass">
    <ItemGroup>
      <_CompiledScopedCss Include="Components\**\*.razor.css" />
      <None Remove="@(_CompiledScopedCss)" />
      <Content Remove="@(_CompiledScopedCss)" />
      <Content Include="@(_CompiledScopedCss)" />
    </ItemGroup>
  </Target>

  <Target Name="CompileCrossTargetingClientAssets" BeforeTargets="DispatchToInnerBuilds" Condition="'$(IsCrossTargetingBuild)' == 'true'" DependsOnTargets="CompileClientAssets" />
</Project>
