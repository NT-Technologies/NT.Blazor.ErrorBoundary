@inherits Microsoft.AspNetCore.Components.Web.ErrorBoundary
@implements IDisposable

@if (CurrentException is null) {
    @ChildContent
}
else if (FallbackContent is not null) {
    @FallbackContent(new NTErrorBoundaryFailure(CurrentException, _referenceId))
}
else if (ErrorContent is not null) {
    @ErrorContent(CurrentException)
}
else {
    <section class="nt-blazor-error-boundary" role="alert">
        <div class="nt-blazor-error-title" role="heading" aria-level="@Level">@Title</div>
        <p class="nt-blazor-error-message">@Message</p>
        <p class="nt-blazor-error-reference">@ReferenceLabel: <span>@_referenceId</span></p>
        @if (ShouldRenderExceptionDetails) {
            <details class="nt-blazor-error-details">
                <summary>Exception details</summary>
                <pre>@_exceptionDetails</pre>
            </details>
        }
        @if (RendererInfo.IsInteractive) {
            <button type="button" @onclick="Recover">@RetryText</button>
        }
        else {
            <a href="@_navigationManager.Uri">@ReloadText</a>
        }
    </section>
}
